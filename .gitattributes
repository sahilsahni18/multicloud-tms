# Normalise line endings; shell scripts and Docker/K8s files must stay LF
# even when the repo is checked out on Windows.
* text=auto
*.sh    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.tf    text eol=lf
Dockerfile text eol=lf
mvnw    text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf
