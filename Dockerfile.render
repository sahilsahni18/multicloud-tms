# syntax=docker/dockerfile:1.7
#
# TrackFlow as ONE container for free single-instance hosting (Render):
# the React app is built and bundled into the Spring Boot jar, which serves
# both the site and the API from one origin. The Kubernetes images
# (backend/Dockerfile, frontend/Dockerfile) are unchanged.

# ---- web app ---------------------------------------------------------------
FROM node:24-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# The public demo lists the seeded demo accounts on the login page.
ENV VITE_SHOW_DEMO_ACCOUNTS=true
RUN npm run build

# ---- backend + bundled web app ----------------------------------------------
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY backend/.mvn/ .mvn/
COPY backend/mvnw backend/pom.xml ./
RUN chmod +x mvnw && ./mvnw -B -q -ntp dependency:go-offline
COPY backend/src/ src/
COPY --from=web /web/dist/ src/main/resources/static/
RUN ./mvnw -B -q -ntp package -DskipTests \
 && cp target/tms-backend-*.jar app.jar \
 && java -Djarmode=tools -jar app.jar extract --layers --destination extracted

# ---- runtime -----------------------------------------------------------------
FROM gcr.io/distroless/java21-debian12:nonroot
WORKDIR /app
COPY --from=build /src/extracted/dependencies/ ./
COPY --from=build /src/extracted/spring-boot-loader/ ./
COPY --from=build /src/extracted/snapshot-dependencies/ ./
COPY --from=build /src/extracted/application/ ./

ENV TZ=UTC \
    SPRING_PROFILES_ACTIVE=render,demo-data
EXPOSE 8080
USER nonroot

# Fits a 512 MB instance: small fixed heap, serial GC, C1-only JIT for a faster start.
ENTRYPOINT ["/usr/bin/java", "-Xmx256m", "-Xss512k", "-XX:MaxMetaspaceSize=160m", "-XX:ReservedCodeCacheSize=48m", "-XX:+UseSerialGC", "-XX:TieredStopAtLevel=1", "-XX:+ExitOnOutOfMemoryError", "-Djava.io.tmpdir=/tmp", "-jar", "app.jar"]
